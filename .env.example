# Shopify Storefront API — Headless sales channel. All three required to
# hit real Shopify data; without them, lib/shopify/queries.ts falls back
# to lib/shopify/mock-data.ts so the whole site (including cart) still
# works in local dev and on Vercel Preview. In a genuine production
# deploy (VERCEL_ENV=production), being unconfigured is instead treated
# as an error (throws) rather than silently serving mock products to a
# real customer — see isShopifyConfigured()/isProductionRuntime() in
# lib/shopify/client.ts and lib/env.ts.

# Store domain, e.g. your-store.myshopify.com — NEXT_PUBLIC_ because it's
# not a secret (it's the endpoint host), and lib/shopify/client.ts reads it
# for every request.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API public access token (Headless channel → API credentials).
# Safe to expose to the browser — used for ordinary reads (products,
# collections, cart).
NEXT_PUBLIC_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=your-storefront-public-token

# Storefront API private access token (Headless channel → API credentials).
# Server-only — no NEXT_PUBLIC_ prefix, so Next never inlines it into a
# client bundle. Used only for privileged mutations (customerCreate).
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your-storefront-private-token

# Also read by getShopPolicies() (src/lib/shopify/queries.ts), which
# powers /privacy, /returns, /shipping, /terms. Each of those pages 404s
# on its own if its policy hasn't been filled in yet under Shopify admin
# → Settings → Policies — no separate env var needed for that.

# Production URL — used for metadataBase (canonical URLs, OG/Twitter image
# resolution), the sitemap, and robots.txt. Falls back to localhost in
# development. REQUIRED in a genuine production deploy: next.config.ts
# fails the build outright (VERCEL_ENV=production only) if this is unset
# or still points at localhost/*.vercel.app — set it in Vercel → Project
# Settings → Environment Variables (Production) to the real domain before
# promoting to production.
NEXT_PUBLIC_SITE_URL=https://tomfoolery.example.com

# Resend — powers /contact and /gifting (src/app/api/contact/route.ts,
# src/app/api/gifting/route.ts, src/lib/resend/client.ts,
# src/lib/forms/). Without RESEND_API_KEY set, submitting either form
# returns a clear "not set up yet" error instead of crashing.
#
# One-time setup on Resend's side before this can actually send mail:
#   1. Sign up at https://resend.com (free tier is plenty for these two forms).
#   2. Domains → Add Domain → add tomfoolerychocolate.com (or a subdomain
#      like mail.tomfoolerychocolate.com) and add the DNS records Resend
#      gives you (SPF/DKIM, usually a couple of TXT/CNAME records) wherever
#      that domain's DNS is managed. Verification can take a few minutes to
#      a few hours to propagate. As of this writing (2026-09-28) this has
#      NOT been done yet — tomfoolerychocolate.com's DNS has no Resend
#      records at all.
#   3. API Keys → Create API Key → copy it into RESEND_API_KEY below (and
#      into Vercel: Project Settings → Environment Variables → add
#      RESEND_API_KEY for Production + Preview) — it's only shown once.
#   4. Once the domain is verified, set CONTACT_FROM_EMAIL/GIFTING_FROM_EMAIL
#      below to an address on that domain (e.g. "Tom Foolery Website
#      <no-reply@tomfoolerychocolate.com>"). Until then, RESEND_API_KEY
#      still needs to be set (Resend issues keys before domain
#      verification), but the *_FROM_EMAIL/*_TO_EMAIL vars below can only
#      really deliver once verification is done — Resend's shared sandbox
#      sender (onboarding@resend.dev) only delivers to the Resend
#      account's own registered email, not a real business inbox.
RESEND_API_KEY=your-resend-api-key

# CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL — REQUIRED in a genuine production
# deploy. src/lib/forms/email-config.ts enforces this: in production, a
# missing value here (or a missing RESEND_API_KEY above) makes /api/contact
# return a friendly 503 to the visitor and log a loud server error, rather
# than falling back to anyone's personal inbox or the unverified sandbox
# sender. Outside production (local dev, Vercel Preview), both fall back
# to a clearly-labeled dev sender so the form still works without these
# set — see DEV_FALLBACK_TO/DEV_FALLBACK_FROM in that same file.
CONTACT_TO_EMAIL=garrett@tomfoolerychocolate.com
CONTACT_FROM_EMAIL=Tom Foolery Website <no-reply@tomfoolerychocolate.com>

# GIFTING_TO_EMAIL / GIFTING_FROM_EMAIL — same requirement as
# CONTACT_TO_EMAIL/CONTACT_FROM_EMAIL above, for /api/gifting
# (src/app/api/gifting/route.ts). Kept as a separate pair (not reusing the
# CONTACT_* vars) so gifting inquiries can be routed differently later
# (e.g. to a sales inbox) without affecting the Contact page.
GIFTING_TO_EMAIL=garrett@tomfoolerychocolate.com
GIFTING_FROM_EMAIL=Tom Foolery Website <no-reply@tomfoolerychocolate.com>

# HubSpot gifting form — where every "Start a Custom Order" CTA goes
# (/gifting hero + Custom & Branded / Weddings & Events panels, and the
# band under each collection). Paste the form's HubSpot share link
# (Marketing → Forms → the form → Share → copy link, e.g.
# https://share.hsforms.com/…). NEXT_PUBLIC_ because it's a public URL
# read by client components. Unset → those CTAs fall back to the on-site
# Resend inquiry form at /gifting#custom-gift; set → that on-site form is
# removed from /gifting. See src/lib/gifting/hubspot.ts.
# NEXT_PUBLIC_HUBSPOT_GIFTING_FORM_URL=https://share.hsforms.com/your-form-id

# Omnisend brand ID — loads Omnisend's own on-site tracking/popup snippet
# (src/components/analytics/OmnisendSnippet.tsx, in the root layout).
# NEXT_PUBLIC_ because the snippet runs entirely client-side; this is the
# same brand ID Omnisend's own dashboard snippet hardcodes, just read from
# an env var instead. Without it set, OmnisendSnippet.tsx skips loading
# the snippet entirely (dev-only console.warn, no error) — the whole site
# still works, you just won't see Omnisend's popup or get its tracking.
#
# Omnisend dashboard → Store settings → find your brand ID (it's also the
# first segment of your API key, before the "-", if you already have one).
# See docs/INTEGRATIONS.md for the full on-site-popup setup.
#
# Known issue as of 2026-09-28: Omnisend's own settings fetch CORS-rejects
# requests from *.vercel.app (an unrecognized hostname for this brand ID),
# which appears to hold back the popup/tracking regardless of how
# correctly this snippet loads. Needs a recheck once the real production
# domain (NEXT_PUBLIC_SITE_URL above) is registered with Omnisend and
# actually serving traffic — see docs/INTEGRATIONS.md.
NEXT_PUBLIC_OMNISEND_BRAND_ID=your-omnisend-brand-id

# Optional — lets the footer's "Newsletter" link open Omnisend's hosted
# signup form on demand (src/components/layout/NewsletterTriggerButton.tsx)
# instead of on whatever automatic trigger (time delay, exit intent, etc.)
# the dashboard popup above already uses. Requires a *separate* form in
# the Omnisend dashboard explicitly set to "Custom Trigger" display mode
# (Behavior Settings → Display) — copy that form's ID here. Without this
# set, the Newsletter link doesn't render at all (see that component's own
# comment) rather than shipping a dead link.
# NEXT_PUBLIC_OMNISEND_NEWSLETTER_FORM_ID=your-custom-trigger-form-id

# Google Analytics 4 — src/components/analytics/GoogleAnalyticsSnippet.tsx
# (root layout), via @next/third-parties/google's <GoogleAnalytics> rather
# than hand-rolled gtag.js. Your GA4 Measurement ID (Admin → Data Streams
# → your web stream), always starts with "G-". NEXT_PUBLIC_ because it's
# not a secret — it's just an endpoint identifier, same as the Shopify/
# Omnisend IDs above.
#
# Set this in Vercel → Project Settings → Environment Variables for
# **Production only** — leave Preview and Development unset so preview
# deploys and local dev don't pollute real GA4 data. Unset entirely here
# (including local .env.local) is intentional: the component renders
# nothing without it (see its own comment), which is also what keeps
# `next dev` from ever firing it.
#
# Relies on GA4's own Enhanced Measurement "page changes based on browser
# history events" (Admin → Data Streams → your stream → Enhanced
# measurement) for client-side route-change pageviews — confirm that's
# enabled in the GA4 dashboard. Do NOT add manual page_view tracking
# alongside it; see that component's own comment for why.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# HubSpot private-app access token — makes /find-us (the store locator)
# live: every ~6 hours it re-pulls the companies whose `last_order_date`
# is within the last 90 days and maps them (src/lib/stockists/). Server-
# only — no NEXT_PUBLIC_ prefix, never sent to the browser.
#
# HubSpot → Settings → Integrations → Private Apps → Create a private app
# → Scopes: `crm.objects.companies.read` only (this site never writes to
# HubSpot) → Create → copy the access token here and into Vercel →
# Project Settings → Environment Variables (Production + Preview).
#
# Unset → /find-us serves the committed snapshot instead
# (src/data/stockists.json, refreshed by hand with `npm run
# sync-stockists`) — real stores, but frozen at the last sync, so new
# accounts don't appear and lapsed ones don't drop off. See
# docs/INTEGRATIONS.md "HubSpot — store locator".
# HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional — basemap for the /find-us map, as a MapLibre style URL.
# Defaults to OpenFreeMap's "positron" style (free, no key, no account).
# Only set this to switch tile providers (MapTiler, Stadia, self-hosted…).
# NEXT_PUBLIC_ because the browser fetches the style and tiles directly.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
