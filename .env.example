# Shopify Storefront API — Headless sales channel. All three required to
# hit real Shopify data; without them, lib/shopify/queries.ts transparently
# falls back to lib/shopify/mock-data.ts so the whole site (including cart)
# still works.

# Store domain, e.g. your-store.myshopify.com — NEXT_PUBLIC_ because it's
# not a secret (it's the endpoint host), and lib/shopify/client.ts reads it
# for every request.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API public access token (Headless channel → API credentials).
# Safe to expose to the browser — used for ordinary reads (products,
# collections, cart).
NEXT_PUBLIC_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=your-storefront-public-token

# Storefront API private access token (Headless channel → API credentials).
# Server-only — no NEXT_PUBLIC_ prefix, so Next never inlines it into a
# client bundle. Used only for privileged mutations (customerCreate).
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your-storefront-private-token

# Production URL — used for metadataBase (canonical URLs, OG/Twitter image
# resolution) and the sitemap. Falls back to localhost in development.
NEXT_PUBLIC_SITE_URL=https://tomfoolery.example.com
