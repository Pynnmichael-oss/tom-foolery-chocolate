# Shopify Storefront API — both required to hit real Shopify data.
# Without them, lib/shopify/queries.ts transparently falls back to
# lib/shopify/mock-data.ts so the whole site (including cart) still works.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-api-token
