# Shopify Storefront API — Headless sales channel. All three required to
# hit real Shopify data; without them, lib/shopify/queries.ts transparently
# falls back to lib/shopify/mock-data.ts so the whole site (including cart)
# still works.

# Store domain, e.g. your-store.myshopify.com — NEXT_PUBLIC_ because it's
# not a secret (it's the endpoint host), and lib/shopify/client.ts reads it
# for every request.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API public access token (Headless channel → API credentials).
# Safe to expose to the browser — used for ordinary reads (products,
# collections, cart).
NEXT_PUBLIC_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=your-storefront-public-token

# Storefront API private access token (Headless channel → API credentials).
# Server-only — no NEXT_PUBLIC_ prefix, so Next never inlines it into a
# client bundle. Used only for privileged mutations (customerCreate).
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your-storefront-private-token

# Production URL — used for metadataBase (canonical URLs, OG/Twitter image
# resolution) and the sitemap. Falls back to localhost in development.
NEXT_PUBLIC_SITE_URL=https://tomfoolery.example.com

# Resend — powers the /contact page (src/app/api/contact/route.ts,
# src/lib/resend/client.ts). Without RESEND_API_KEY set, submitting the
# form returns a clear "not set up yet" error instead of crashing.
#
# One-time setup on Resend's side before this can actually send mail:
#   1. Sign up at https://resend.com (free tier is plenty for a contact form).
#   2. Domains → Add Domain → add tomfoolerychocolate.com (or a subdomain
#      like mail.tomfoolerychocolate.com) and add the DNS records Resend
#      gives you (SPF/DKIM, usually a couple of TXT/CNAME records) wherever
#      that domain's DNS is managed. Verification can take a few minutes to
#      a few hours to propagate.
#   3. API Keys → Create API Key → copy it into RESEND_API_KEY below (and
#      into Vercel: Project Settings → Environment Variables → add
#      RESEND_API_KEY for Production + Preview) — it's only shown once.
#   4. Once the domain is verified, set CONTACT_FROM_EMAIL below to an
#      address on that domain (e.g. "Tom Foolery Website
#      <no-reply@tomfoolerychocolate.com>"). Until then, the code defaults
#      to Resend's own shared sandbox sender (onboarding@resend.dev), which
#      works with any API key but can only deliver to the email address
#      the Resend account itself was signed up with. Don't skip step 2
#      expecting the form to work end-to-end.
RESEND_API_KEY=your-resend-api-key

# Optional overrides for the Contact page. Sensible defaults are baked
# into src/app/api/contact/route.ts if you leave these unset — as of this
# writing that default `to` is TEMPORARILY Michael's own inbox (see the
# TODO on DEFAULT_TO in that file), not Garrett's, because the sandbox
# sender above can only deliver to the Resend account's own verified
# email until a real domain is verified. Switch it back once that
# happens — either here or directly in route.ts.
# CONTACT_TO_EMAIL=garrett@tomfoolerychocolate.com
# CONTACT_FROM_EMAIL=Tom Foolery Website <no-reply@tomfoolerychocolate.com>

# Same deal for /gifting (src/app/api/gifting/route.ts) — a separate pair
# of env vars rather than reusing CONTACT_TO_EMAIL/CONTACT_FROM_EMAIL so
# gifting inquiries can be routed differently later (e.g. to a sales
# inbox) without affecting the Contact page. Also defaults to Michael's
# inbox TEMPORARILY until the domain is verified — see the TODO on
# DEFAULT_TO in that route file.
# GIFTING_TO_EMAIL=garrett@tomfoolerychocolate.com
# GIFTING_FROM_EMAIL=Tom Foolery Website <no-reply@tomfoolerychocolate.com>
